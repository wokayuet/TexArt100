{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "7160355f26a949258200759aa90fc204",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Gaussian9_SceneColor (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1819.1998291015625,
            "y": 2548.800048828125,
            "width": 286.39990234375,
            "height": 301.599609375
        }
    },
    "m_Slots": [
        {
            "m_Id": "29d18d338dcb42dd86134d3ba12e9efd"
        },
        {
            "m_Id": "e5baeff078ae4bd0b265926bfe176440"
        },
        {
            "m_Id": "47f1c6a322d54d66930993c12cc40450"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Gaussian9_SceneColor",
    "m_FunctionSource": "",
    "m_FunctionBody": "// —— 只写片段：直接给 Out 赋值 ——\r\n// 这里假设 _CameraOpaqueTexture 与 _ScreenParams 已由 SG 生成的 Shader 提供\r\n\r\nconst float w0 = 0.227027027;\r\nconst float w1 = 0.194594595;\r\nconst float w2 = 0.121621622;\r\n\r\nfloat2 texel = 1.0 / _ScreenParams.xy;\r\nfloat2 off1  = texel * radiusPx;\r\nfloat2 off2  = texel * (radiusPx * 2.0);\r\n\r\nfloat4 c = SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv) * w0;\r\n\r\nc += ( SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv + float2( off1.x, 0)) +\r\n       SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv - float2( off1.x, 0)) ) * w1;\r\n\r\nc += ( SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv + float2( off2.x, 0)) +\r\n       SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv - float2( off2.x, 0)) ) * w2;\r\n\r\nc += ( SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv + float2(0,  off1.y)) +\r\n       SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv - float2(0,  off1.y)) ) * w1;\r\n\r\nc += ( SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv + float2(0,  off2.y)) +\r\n       SAMPLE_TEXTURE2D(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, uv - float2(0,  off2.y)) ) * w2;\r\n\r\nconst float norm = (w0 + 4.0 * (w1 + w2));\r\nOut = c / norm;\r\n"
}

